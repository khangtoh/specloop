{
  "name": "specloop",
  "version": "0.1.0",
  "description": "Spec-driven loop engineering: a repeatable construct for driving coding agents through numbered phase specs with enforced structure and mandatory status handoffs.",
  "type": "module",
  "bin": {
    "specloop": "./bin/specloop.ts"
  },
  "files": [
    "bin",
    "src",
    "template",
    "plugin",
    "schema",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "specloop": "bun run bin/specloop.ts",
    "check:spec": "bun run bin/specloop.ts check --dir template",
    "status": "bun run bin/specloop.ts status --dir template",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "spec-driven",
    "agents",
    "coding-agent",
    "loop-engineering",
    "claude-code",
    "codex",
    "workflow",
    "methodology"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/bun": "latest"
  }
}
